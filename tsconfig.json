{
	"compilerOptions": {
		// esbuild is the bundler (see .esbuild.ts); tsc is typecheck-only. Bundler
		// resolution (not Node16) so the ESM sqllens package imports cleanly from
		// this CJS-bundled project. noUnusedParameters intentionally absent —
		// ESLint's no-unused-vars covers it.
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"esModuleInterop": true,
		"target": "ES2022",
		"lib": ["ES2022"],
		"sourceMap": true,
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"types": ["node"],
		"noEmit": true
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"temp_auto/**/*",
		"**/*.test.ts",
		"src/test/**/*",
		"src/fixtures/**/*",
		"out/**/*",
		"dist/**/*"
	]
}
