{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": ["ES2022"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"types": ["node"],
		"outDir": "out"
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"temp_auto/**/*",
		"**/*.test.ts",
		"src/test/**/*",
		"src/fixtures/**/*",
		"out/**/*",
		"dist/**/*"
	]
}
