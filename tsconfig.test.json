{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedParameters": false,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": [
			"node"
		],
		"outDir": "out/test"
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"out/**/*",
		"dist/**/*"
	]
}
