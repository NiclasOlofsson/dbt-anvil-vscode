				"--extensionDevelopmentPath=${workspaceFolder}",
				"--folder-uri=file:///c:/Development/github/dbt-core-mcp/examples/jaffle_shop"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			]
		},
		{
			"name": "Run Extension (Watch)",
			"type": "extensionHost",
			"request": "launch",
			"internalConsoleOptions": "neverOpen",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--folder-uri=file:///c:/Development/github/dbt-core-mcp/examples/jaffle_shop"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			]
		}
	]
