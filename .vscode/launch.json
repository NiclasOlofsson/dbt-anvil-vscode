{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension (oatanalytics)",
			"type": "extensionHost",
			"request": "launch",
			"internalConsoleOptions": "neverOpen",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--folder-uri=file:///c:/Development/dbt_oatanalytics"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			]
		},
		{
			"name": "Run Extension (jaffle_shop)",
			"type": "extensionHost",
			"request": "launch",
			"internalConsoleOptions": "neverOpen",
