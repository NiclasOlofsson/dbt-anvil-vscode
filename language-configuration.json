{
	"comments": {
		"lineComment": "--",
		"blockComment": [ "/*", "*/" ]
	},
	"brackets": [
		[ "{", "}" ],
		[ "[", "]" ],
		[ "(", ")" ]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "'", "close": "'", "notIn": ["string", "comment"] },
		{ "open": "\"", "close": "\"", "notIn": ["string"] },
		{ "open": "{{", "close": "}}" },
		{ "open": "{%", "close": "%}" },
		{ "open": "{#", "close": "#}" }
	],
	"surroundingPairs": [
		[ "{", "}" ],
		[ "[", "]" ],
		[ "(", ")" ],
		[ "'", "'" ],
		[ "\"", "\"" ]
	],
	"folding": {
		"offSide": false,
		"markers": {
			"start": "^\\s*--\\s*#region",
			"end": "^\\s*--\\s*#endregion"
		}
	}
}
